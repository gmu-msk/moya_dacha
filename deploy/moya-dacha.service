# Юнит для VPS (ADR-0004). Кладётся в /etc/systemd/system/.
# Секреты — в /etc/moya-dacha.env, который в git не попадает.
[Unit]
Description=МояДача API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=moya-dacha
Group=moya-dacha
EnvironmentFile=/etc/moya-dacha.env
ExecStart=/usr/local/bin/moya-dacha-server
Restart=always
RestartSec=3

# Файлы пользователей (аватары, дальше фотографии постов) лежат в
# /var/lib/moya-dacha — systemd заводит эту папку сам и отдаёт её сервису.
# Без неё ProtectSystem=strict не дал бы сервису писать никуда
# (specs/002-profile.md, ADR-0011). В /etc/moya-dacha.env к ней ведёт
# MEDIA_DIR=/var/lib/moya-dacha/media.
StateDirectory=moya-dacha

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
