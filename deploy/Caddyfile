# Caddy сам получает и продлевает TLS-сертификат (ADR-0004).
# Домен подставляет deploy/setup.sh вместо example.ru.
example.ru {
	encode gzip

	# APK для тестировщиков: его кладёт сюда деплой, ссылка — /app.apk.
	handle /app.apk {
		root * /var/www/moya-dacha
		rewrite * /moya-dacha.apk
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=moya-dacha.apk"
		file_server
	}

	# Сведения о сборке, которая лежит в /app.apk: по ним приложение
	# узнаёт, что вышла новая версия (specs/017-app-updates.md).
	handle /app.json {
		root * /var/www/moya-dacha
		rewrite * /moya-dacha.json
		header Cache-Control no-cache
		file_server
	}

	handle {
		# Загрузка медиа идёт через бэкенд (он режет EXIF и делает превью),
		# поэтому тело запроса заметно больше обычного API-запроса.
		request_body {
			max_size 25MB
		}

		reverse_proxy 127.0.0.1:8080
	}
}
