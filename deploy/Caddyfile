# Caddy сам получает и продлевает TLS-сертификат (ADR-0004).
# Подставьте реальный домен вместо example.ru.
example.ru {
	encode gzip

	# Загрузка медиа идёт через бэкенд (он режет EXIF и делает превью),
	# поэтому тело запроса заметно больше обычного API-запроса.
	request_body {
		max_size 25MB
	}

	reverse_proxy 127.0.0.1:8080
}
